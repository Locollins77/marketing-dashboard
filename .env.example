PORT=3000
SESSION_SECRET=change-this-to-a-random-string

# Postgres connection string. Locally, either run your own Postgres and point here,
# or use the "External Database URL" from your Render Postgres instance.
# On Render itself, set this to the "Internal Database URL" from the same instance.
DATABASE_URL=postgres://user:password@localhost:5432/marketing_dashboard

# Phase 0 login (single internal user, created by `npm run seed`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Real platform API credentials go here in later phases (WhatConverts, Google Ads,
# Meta Ads, Hatch, LeadPerfection) - never commit real values, this file is a template only.

# WhatConverts (Account Settings -> API) - one token/secret pair per brand, since
# each brand has its own separate WhatConverts account. Either pair can be left
# blank and that brand's sync is skipped until it's filled in.
WHATCONVERTS_SEAMLESS_TOKEN=
WHATCONVERTS_SEAMLESS_SECRET=
WHATCONVERTS_BATHSHOWER_TOKEN=
WHATCONVERTS_BATHSHOWER_SECRET=

# Google Ads - both brands are managed under one Manager (MCC) account, so these five
# are shared (one developer token, one OAuth app, one refresh token, one login
# customer ID for the MCC); only the per-brand customer ID below differs.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Individual brand account IDs (with or without dashes, either works) - leave one
# blank to skip that brand's sync until it's filled in.
GOOGLE_ADS_SEAMLESS_CUSTOMER_ID=
GOOGLE_ADS_BATHSHOWER_CUSTOMER_ID=

# Meta Ads - both brands share ONE ad account, so there's no per-brand credential
# split like WhatConverts/Google Ads. Brand is instead inferred per-campaign from
# which Facebook Page/Instagram account its ads promote (see server/sync/metaAds.js).
# META_ACCESS_TOKEN is a long-lived user token (~60 days) generated via OAuth
# Playground/Graph API Explorer - it does NOT auto-refresh like Google's refresh
# token does, so it needs manual regeneration roughly every 2 months.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Facebook Page ID and Instagram Business Account ID for each brand (found in Meta
# Business Settings -> Accounts -> Pages / Instagram accounts).
META_PAGE_SEAMLESS_ID=
META_PAGE_BATHSHOWER_ID=
META_IG_SEAMLESS_ID=
META_IG_BATHSHOWER_ID=

# LeadPerfection (training.leadperfection.com/swagger) - one CRM account shared across
# both brands, with brand distinguished by businessID (a LeadPerfection "Business Unit").
# Run `node server/scripts/leadPerfectionValidParams.js` after filling in the auth vars
# below to discover the valid businessID/promoterID/productsold codes for this account
# before filling in the rest.
LEADPERFECTION_BASE_URL=https://api.leadperfection.com
LEADPERFECTION_USERNAME=
LEADPERFECTION_PASSWORD=
LEADPERFECTION_CLIENT_ID=
LEADPERFECTION_APP_KEY=
# Business Unit ID per brand, from GetLeadSourceValidParameters (type=SubSource or
# however businessID is surfaced for this account) - leave one blank to skip pushing
# that brand's new leads into LeadPerfection until it's filled in.
LEADPERFECTION_SEAMLESS_BUSINESS_ID=
LEADPERFECTION_BATHSHOWER_BUSINESS_ID=
# Default promoter/product codes to stamp on leads pushed in automatically (from ad
# platforms / WhatConverts), from GetLeadSourceValidParameters type=Promoter/Products.
LEADPERFECTION_PROMOTER_ID=
LEADPERFECTION_PRODUCT_ID=
# Optional CSR ID to stamp on auto-created prospects, if your account requires one.
LEADPERFECTION_CSR_ID=
