PORT=3000
SESSION_SECRET=change-this-to-a-random-string

# Postgres connection string. Locally, either run your own Postgres and point here,
# or use the "External Database URL" from your Render Postgres instance.
# On Render itself, set this to the "Internal Database URL" from the same instance.
DATABASE_URL=postgres://user:password@localhost:5432/marketing_dashboard

# Phase 0 login (single internal user, created by `npm run seed`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Real platform API credentials go here in later phases (WhatConverts, Google Ads,
# Meta Ads, Hatch, LeadPerfection) - never commit real values, this file is a template only.

# WhatConverts (Account Settings -> API) - one token/secret pair per brand, since
# each brand has its own separate WhatConverts account. Either pair can be left
# blank and that brand's sync is skipped until it's filled in.
WHATCONVERTS_SEAMLESS_TOKEN=
WHATCONVERTS_SEAMLESS_SECRET=
WHATCONVERTS_BATHSHOWER_TOKEN=
WHATCONVERTS_BATHSHOWER_SECRET=
